{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "latitude-e7": {
      "type": "string"
    },
    "longitude-e7": {
      "type": "string"
    },
    "main-street": {
      "type": "string"
    },
    "map-hex": {
      "type": "string"
    },
    "map-message-id": {
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "observed-by": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "occurred-at": {
      "format": "date-time",
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "phase-approach": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "approach": {
            "type": "string"
          },
          "phase-number": {
            "maximum": 40,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "approach"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "second-street": {
      "type": "string"
    },
    "sequence": {
      "type": "string"
    },
    "source-device-id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([a-zA-Z0-9_-]+)$",
      "type": "string"
    },
    "spat-hex": {
      "type": "string"
    },
    "spat-message-id": {
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "occurred-at",
    "sequence",
    "source-device-id"
  ],
  "type": "object"
}